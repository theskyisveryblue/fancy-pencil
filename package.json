{
  "name": "fancy-pencil",
  "private": false,
  "version": "0.1.0",
  "type": "module",
  "description": "Local-first spatial editor with .pen import and export.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "node scripts/browser-check.mjs"
  },
  "dependencies": {
    "jszip": "^3.10.1",
    "@fontsource/inter": "^5.3.0",
    "openfig-core": "^0.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/react": "^16.0.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/node": "^22.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^25.0.1",
    "playwright": "^1.48.0",
    "typescript": "^5.6.3",
    "vite": "^8.3.1",
    "vitest": "^4.1.11"
  }
}
